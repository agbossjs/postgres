{
  "name": "@agboss/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL stores for AGBoss: several application instances share execution trees on one database — leases, records, trees, pauses, the child queue, checkpoints, fenced effects, the lease log, budgets, history, rate limits, mesh requests and outbound calls.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "homepage": "https://agboss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/postgres.git"
  },
  "bugs": {
    "url": "https://github.com/agbossjs/postgres/issues"
  },
  "keywords": [
    "agboss",
    "postgres",
    "postgresql",
    "langgraph",
    "checkpoint",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agboss-postgres": "bin/agboss-postgres.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.processes.json",
    "lint": "eslint .",
    "check:types": "node scripts/check-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "precoverage": "npm run build",
    "coverage": "node scripts/check-test-run.mjs --expect test-run.json -- vitest run --coverage",
    "check:api": "npm run build && node scripts/api-report.mjs",
    "api:update": "npm run build && node scripts/api-report.mjs --write",
    "check": "npm run format:check && npm run check:suppressions && npm run check:installs && npm run check:real-time && npm run check:types && npm run lint && npm run typecheck && npm run coverage && npm run check:api",
    "pack:framework": "node scripts/pack-framework.mjs",
    "install:packed": "node scripts/install-packed.mjs",
    "install:published": "node scripts/install-published.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:installs": "node scripts/check-installs.mjs",
    "check:real-time": "node scripts/check-real-time.mjs",
    "test:faults": "node scripts/check-test-run.mjs --expect test-run.faults.json -- vitest run --config vitest.faults.config.ts",
    "test:key-text-seeds": "vitest run tests/stores/key-text.property.test.ts"
  },
  "peerDependencies": {
    "@agboss/core": "^0.1.1",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph-checkpoint": "^1.2.0"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.60.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
